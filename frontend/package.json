{
  "name": "finora-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/crawlPolicy.mjs",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "generate:types": "npx --yes openapi-typescript@7.13.0 ../backend/openapi/openapi.json -o src/api/generated-types.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "chart.js": "^4.4.3",
    "firebase": "^13.0.0",
    "framer-motion": "^13.4.5",
    "gsap": "^3.15.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true
  },
  "overrides": {
    "sharp": "^0.35.4",
    "@grpc/grpc-js": "^1.14.5",
    "postcss-selector-parser": "7.1.6"
  }
}
