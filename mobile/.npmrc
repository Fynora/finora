# Same install mode CI uses (`npm ci --legacy-peer-deps` in .github/workflows/ci.yml). Added in
# #1702 for expo-modules-core 57's peer range on react-native-worklets, which conflicted with the
# 0.13.x react-native-reanimated 4.7 requires; EAS Build runs plain `npm ci`, so without this file
# every cloud build failed at Install dependencies. On SDK 58 that conflict is gone (plain `npm ci`
# succeeds, measured 2026-10-30) but installs 11 more peer packages, so removing this file changes
# the installed tree and is a separate, separately tested change.
legacy-peer-deps=true
