# Same install mode CI uses (`npm ci --legacy-peer-deps` in .github/workflows/ci.yml, which
# explains the conflict): expo-modules-core's stale peerOptional range on react-native-worklets
# (^0.10.0) conflicts with the 0.13.x that react-native-reanimated 4.7.0 requires. EAS Build runs
# plain `npm ci`, so without this file every cloud build fails at Install dependencies.
legacy-peer-deps=true
