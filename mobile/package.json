  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "generate:glass-mesh": "node scripts/generate-glass-mesh.mjs",
    "_test_comment": "--experimental-vm-modules is required, not optional: client.ts reaches endpoints.ts through a dynamic import (they are mutually dependent, so a static one would be circular). Without the flag Node refuses that import inside Jest's VM, the refresh-on-401 branch throws before any network call, and every test touching it silently exercises the forced-sign-out path instead -- passing while asserting the opposite of what it claims. Metro implements import() itself, so this is a test-runner limitation rather than anything about the app.",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "expo lint --max-warnings 0",
    "postinstall": "patch-package",
    "generate:types": "npx --yes openapi-typescript@7.13.0 ../backend/openapi/openapi.json -o src/api/generated-types.ts"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker",
        "@sentry/react-native",
        "react"
      ]
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "decode-uri-component": "^0.5.0",
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    },
    "react-native-notify-kit": {
      "@expo/require-utils": {
        "typescript": "$typescript"
      }
    },
    "@grpc/grpc-js": "^1.14.5",
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
