   // members to store the initial launch intent
   var intent: Intent? = null
   var isPending: Boolean = false
+
+  // Fynora patch: a share (has a mime type) or an "Open with" of a file (ACTION_VIEW on a
+  // content:// URI, whose type may be left for the receiver to resolve).
+  fun isShareOrOpenFile(intent: Intent?): Boolean {
+    if (intent == null) return false
+    if (intent.type != null) return true
+    return intent.action == Intent.ACTION_VIEW && intent.data?.scheme == "content"
+  }
